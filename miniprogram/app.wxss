page {
  --small-action-gold: #dbbf7a;
  --small-action-border: rgba(201, 169, 97, 0.55);
  --small-action-fill: #08060f;
  min-height: 100%;
  background: #08060f;
  color: #eae4d4;
  font-family: serif;
}

.small-action {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 12rpx 28rpx;
  border: 1rpx solid var(--small-action-border);
  border-radius: 20rpx;
  background: linear-gradient(165deg, rgba(201, 169, 97, 0.12), rgba(201, 169, 97, 0.035));
  color: var(--small-action-gold);
  font-size: 28rpx;
  line-height: 1.4;
}
.small-action::after {
  border: 0;
}
.small-action.button-hover {
  background: #131022;
}

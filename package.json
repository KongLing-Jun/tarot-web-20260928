{
  "name": "tarot-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "brand:sync": "node scripts/sync-brand.mjs --write",
    "brand:check": "node scripts/sync-brand.mjs --check",
    "prebuild": "npm run brand:check",
    "pretest": "npm run brand:check",
    "images:sync": "tsx scripts/sync-images.ts",
    "images:verify": "tsx scripts/verify-images.ts",
    "db:migrate": "node scripts/migrate-db.mjs",
    "test:db": "node scripts/test-db.mjs",
    "dev": "node scripts/run-next.mjs dev",
    "dev:miniapp": "node scripts/run-next.mjs miniapp",
    "build": "next build",
    "build:linux": "docker buildx build --platform linux/amd64 --file Dockerfile.build --output type=local,dest=release .",
    "build:linux:arm64": "docker buildx build --platform linux/arm64 --file Dockerfile.build --output type=local,dest=release .",
    "start": "node scripts/run-next.mjs start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write . --ignore-path .gitignore --ignore-path .prettierignore",
    "format:check": "prettier --check . --ignore-path .gitignore --ignore-path .prettierignore"
  },
  "dependencies": {
    "ali-oss": "^6.23.0",
    "driver.js": "1.8.0",
    "next": "16.1.6",
    "pg": "^8.23.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@libsql/client": "0.17.3",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/ali-oss": "^6.23.3",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "jsdom": "^29.1.1",
    "lightningcss": "^1.32.0",
    "postcss": "^8.5.15",
    "prettier": "3.9.9",
    "promptfoo": "0.122.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^4.1.7"
  }
}

# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# Optional local extraction of Linux release archives
/release/unpacked/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# Private server-side model credentials
/model.config.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local-only architecture drafts and verification captures
/docs/architecture/
/docs/verification/

# local tool settings
.claude/
/project.private.config.json

# agent instructions (local only, never published)
AGENTS.md
CLAUDE.md
